{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@flypigeon/shared": ["packages/shared/src/index.ts"],
      "@flypigeon/db": ["packages/db/src/index.ts"],
      "@flypigeon/node": ["packages/sdk-node/src/index.ts"],
      "@flypigeon/react": ["packages/sdk-react/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".turbo", ".next"]
}
