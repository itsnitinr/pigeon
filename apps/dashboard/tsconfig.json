{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": false,
    "incremental": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@pigeon/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@pigeon/db": [
        "../../packages/db/src/index.ts"
      ],
      "@pigeon/node": [
        "../../packages/sdk-node/src/index.ts"
      ],
      "@pigeon/react": [
        "../../packages/sdk-react/src/index.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
